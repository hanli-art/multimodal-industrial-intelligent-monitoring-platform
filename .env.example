# 复制本文件为 .env 并按需填写；.env 不会被提交到 Git。

# 阿里云百炼（DashScope）API Key：用于千问 VL 大模型场景安全分析（/ws/qwen）。
# 未配置时服务仍可启动，但 /ws/qwen 接口会无法调用大模型。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MySQL 数据库连接（db.py / init_db.py 使用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=industrial_monitor
